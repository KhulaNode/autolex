# Public configuration: applied when the server/container starts.
# Compose runs a prebuilt image. No Dockerfile build step is configured.
AUTOLEX_IMAGE=autolex:local
# Use the actual https origin in production, with no path or trailing slash.
SITE_URL=http://localhost:3000
# Local Compose host port; the container always listens on port 3000.
HOST_PORT=3000

# Demo address; KhulaMail is provisioned independently by KhulaNode.
BUSINESS_EMAIL=info@autolex.co.za
# International number, country code included. No leading local zero.
BUSINESS_WHATSAPP=27730572188

# Leave blank until the official profile URLs are confirmed.
FACEBOOK_URL=
INSTAGRAM_URL=

# Confirmed hours in 24-hour SAST.
WEEKDAY_OPEN=08:00
WEEKDAY_CLOSE=16:30
# Saturday 08:00–11:30 and Sunday closed are in src/lib/business.ts.
